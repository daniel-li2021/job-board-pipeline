<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent: run the local source sync every 3 hours.

  IMPORTANT: edit the absolute paths below to match your machine before
  installing. launchd requires absolute paths.

  Install:
    cd /Users/daniel/Projects/job_scrape_feasibility-automation
    python3 -m venv .venv
    .venv/bin/python -m pip install -r requirements-local.txt
    cp scripts/macos/com.jobboard.local-sources.plist ~/Library/LaunchAgents/
    launchctl load  ~/Library/LaunchAgents/com.jobboard.local-sources.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.jobboard.local-sources.plist
    rm ~/Library/LaunchAgents/com.jobboard.local-sources.plist
  Run once now (for testing):
    launchctl start com.jobboard.local-sources

  Notes:
    - Calendar jobs missed during sleep are coalesced and run after wake.
    - stdout/stderr go to output/logs/ (git-ignored).
    - If the repo lives under Desktop/Documents/Downloads, macOS TCC blocks
      launchd with "Operation not permitted". Fix: System Settings → Privacy &
      Security → Full Disk Access → enable /bin/bash (or move the repo out of
      Desktop, e.g. ~/Projects/...).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobboard.local-sources</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/daniel/Projects/job_scrape_feasibility-automation/scripts/local_source_sync.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/daniel/Projects/job_scrape_feasibility-automation</string>

    <!-- launchd has a minimal PATH; pin Homebrew python + common bins. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHON_BIN</key>
        <string>/Users/daniel/Projects/job_scrape_feasibility-automation/.venv/bin/python3</string>
        <!-- Push over the inherited SSH agent; HTTPS Keychain may select another account. -->
        <key>GIT_CONFIG_COUNT</key>
        <string>1</string>
        <key>GIT_CONFIG_KEY_0</key>
        <string>remote.origin.pushurl</string>
        <key>GIT_CONFIG_VALUE_0</key>
        <string>git@github.com:daniel-li2021/job-board-pipeline.git</string>
        <key>GIT_SSH_COMMAND</key>
        <string>/usr/bin/ssh -o BatchMode=yes</string>
        <key>GIT_TERMINAL_PROMPT</key>
        <string>0</string>
    </dict>

    <!-- Unlike StartInterval, missed calendar events run when the Mac wakes. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>3</integer></dict>
        <dict><key>Hour</key><integer>6</integer></dict>
        <dict><key>Hour</key><integer>9</integer></dict>
        <dict><key>Hour</key><integer>12</integer></dict>
        <dict><key>Hour</key><integer>15</integer></dict>
        <dict><key>Hour</key><integer>18</integer></dict>
        <dict><key>Hour</key><integer>21</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/daniel/Projects/job_scrape_feasibility-automation/output/logs/local-sources.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/daniel/Projects/job_scrape_feasibility-automation/output/logs/local-sources.err.log</string>
</dict>
</plist>
