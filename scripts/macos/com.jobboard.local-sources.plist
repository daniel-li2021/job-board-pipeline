<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent: run the local source sync every 3 hours.

  IMPORTANT: edit the absolute paths below to match your machine before
  installing. launchd requires absolute paths.

  Install:
    cp scripts/macos/com.jobboard.local-sources.plist ~/Library/LaunchAgents/
    launchctl load  ~/Library/LaunchAgents/com.jobboard.local-sources.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.jobboard.local-sources.plist
    rm ~/Library/LaunchAgents/com.jobboard.local-sources.plist
  Run once now (for testing):
    launchctl start com.jobboard.local-sources

  Notes:
    - StartInterval is 10800s (3h). Use 7200 for 2h.
    - launchd does not fire while the Mac is asleep; it runs at the next wake.
    - stdout/stderr go to output/logs/ (git-ignored).
    - If the repo lives under Desktop/Documents/Downloads, macOS TCC blocks
      launchd with "Operation not permitted". Fix: System Settings → Privacy &
      Security → Full Disk Access → enable /bin/bash (or move the repo out of
      Desktop, e.g. ~/Projects/...).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobboard.local-sources</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/daniel/Projects/job_scrape_feasibility-automation/scripts/local_source_sync.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/daniel/Projects/job_scrape_feasibility-automation</string>

    <!-- launchd has a minimal PATH; pin Homebrew python + common bins. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHON_BIN</key>
        <string>/usr/local/bin/python3</string>
    </dict>

    <key>StartInterval</key>
    <integer>10800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/daniel/Projects/job_scrape_feasibility-automation/output/logs/local-sources.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/daniel/Projects/job_scrape_feasibility-automation/output/logs/local-sources.err.log</string>
</dict>
</plist>
